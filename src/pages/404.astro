---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada - Amazing Travel Agency">
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-6 px-4 text-center">
    <span class="font-instrument text-sm font-semibold uppercase text-acent">Error 404</span>
    <h1 class="font-display text-4xl font-bold sm:text-5xl">Página no encontrada</h1>
    <p class="max-w-md font-instrument text-gray-600">
      La página que estás buscando no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="rounded-3xl bg-primary px-6 py-3 font-instrument font-semibold text-white transition-colors hover:bg-[#6e72c3]"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>