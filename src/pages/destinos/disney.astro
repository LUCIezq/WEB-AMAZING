---
import { disney } from "../../data/Disney";
import ArrowLeft from "../../components/icons/ArrowLeft.astro";
import { Image } from "astro:assets";
import DisneyLayout from "../../layouts/DisneyLayout.astro";
import Star from "../../components/icons/Star.astro";
import TopUp from "../../components/TopUp.astro";

const { name, photo, subDestinations, ctaButtons } = disney;
const hotelCategories = ["económico", "moderado", "deluxe"] as const;
---

<DisneyLayout title="Disney - Amazing Travel Agency">
  <section class="relative min-h-[100svh] w-full overflow-hidden">
    <Image
      src={photo}
      alt="Castillo mágico de Disney - Amazing Travel"
      loading="eager"
      class="h-[100svh] w-full object-cover object-center"
    />
    <div
      class="absolute inset-0 z-0 bg-linear-to-t from-black/85 via-black/35 to-black/20"
    >
    </div>

    <a
      id="destination-anchor"
      href="#subdestination-content-orlando"
      class="absolute bottom-5 right-4 z-10 inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/15 px-4 py-2 text-center font-instrument text-xs font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:bg-white/85 hover:text-acent hover:shadow-[0_0_20px_rgba(165,214,239,0.65)] sm:bottom-8 sm:right-8 sm:px-5 sm:text-sm"
    >
      <Star fill="currentColor" width="15" />
      Explorar destino
    </a>

    <div
      class="absolute bottom-20 left-4 right-4 z-10 flex flex-col items-start justify-start gap-4 sm:bottom-28 sm:left-10 sm:right-auto sm:gap-5 lg:left-20"
    >
      <a
        class="relative inline-flex gap-1 items-center justify-center
                        align-middle select-none font-sans font-medium text-center
                        px-5 py-2 text-white text-sm rounded-3xl bg-white/15 border border-white/50
                       hover:bg-white/30 transition-all duration-300 before:absolute place-self-start
                       before:inset-0 before:rounded-3xl before:bg-linear-to-br before:from-white/60
                       before:via-transparent before:to-transparent before:opacity-70 before:pointer-events-none
                       after:absolute after:inset-0 after:rounded-3xl after:bg-linear-to-br after:from-white/30 after:via-transparent after:to-transparent
                        after:opacity-50 after:pointer-events-none antialiased"
        href="/destinos"
      >
        <ArrowLeft />
        Volver a destinos</a
      >
      <h1
        class="font-display text-5xl font-bold text-white sm:text-7xl lg:text-8xl drop-shadow-md"
      >
        {name}
      </h1>

      <div
        class="flex max-w-full flex-wrap mt-7 items-center justify-start gap-3 sm:gap-4"
        aria-label="Seleccionar destino"
      >
        {
          subDestinations.map((e, index) => (
            <button
              type="button"
              class:list={[
                "subdestination-button inline-flex relative gap-1 font-instrument items-center justify-center cursor-pointer",
                "align-middle select-none px-4 py-2 text-center font-medium text-white text-xs rounded-3xl border border-white/50 transition-all duration-300 before:absolute before:inset-0 before:rounded-3xl before:bg-linear-to-br before:from-white/60 before:via-transparent before:to-transparent before:opacity-70 before:pointer-events-none after:absolute after:inset-0 after:rounded-3xl after:bg-linear-to-br after:from-white/30 after:via-transparent after:to-transparent after:opacity-50 after:pointer-events-none antialiased sm:px-5 sm:text-sm",
                index === 0
                  ? "bg-white/90 !text-black shadow-lg"
                  : "bg-white/20 hover:bg-white/80 hover:text-black",
              ]}
              data-subdestination={e.id}
              aria-controls={`subdestination-content-${e.id}`}
              aria-pressed={index === 0}
            >
              {e.label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="bg-white px-4 py-12 sm:px-6 sm:py-16 md:px-10 lg:px-20">
    {
      subDestinations.map((subDestination, index) => (
        <section
          id={`subdestination-content-${subDestination.id}`}
          class:list={[
            "subdestination-content mx-auto max-w-6xl scroll-mt-32",
            index !== 0 && "hidden",
          ]}
          data-subdestination-content={subDestination.id}
          aria-hidden={index !== 0}
        >
          <div class="mb-16">
            <div class="mb-14 flex items-center gap-8">
              <Star fill="#7c80c4" />
              <h3 class="font-display text-4xl font-semibold text-acent sm:text-5xl">
                Parques
              </h3>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {subDestination.parks.map((park) => (
                <article
                  class="group relative min-h-48 min-w-28 overflow-hidden rounded-2xl"
                  aria-labelledby={`park-${park.id}`}
                >
                  <Image
                    src={park.photo}
                    alt={park.name}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 group-hover:rotate-1"
                  />
                  <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent" />
                  <div class="relative flex h-full min-h-48 flex-col justify-end gap-1 p-4 text-white transition-opacity duration-300 group-hover:opacity-0">
                    <h4
                      id={`park-${park.id}`}
                      class="mt-2 font-display text-card-title font-semibold"
                    >
                      {park.name}
                    </h4>
                    <span class="font-instrument text-xs font-semibold uppercase tracking-wide">
                      Parque {park.type}
                    </span>
                  </div>
                  <div class="absolute inset-0 flex translate-y-4 flex-col justify-end bg-linear-to-t from-acent/95 via-primary/85 to-primary/55 p-5 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100">
                    <span
                      class="pointer-events-none absolute right-5 top-4 text-2xl text-white opacity-0 drop-shadow-[0_0_8px_#a5d6ef] transition-all duration-500 group-hover:rotate-12 group-hover:opacity-100"
                      aria-hidden="true"
                    >
                      ✦
                    </span>
                    <span
                      class="pointer-events-none absolute right-10 top-10 text-sm text-button opacity-0 drop-shadow-[0_0_6px_#7c80c4] transition-all delay-100 duration-500 group-hover:-translate-y-1 group-hover:opacity-100"
                      aria-hidden="true"
                    >
                      ✦
                    </span>
                    <h4 class="mb-2 translate-y-3 font-display text-card-title font-semibold text-white opacity-0 transition-all delay-75 duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                      {park.name}
                    </h4>
                    <p class="translate-y-3 font-instrument text-sm leading-snug text-white/90 opacity-0 transition-all delay-150 duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                      Lorem ipsum dolor sit amet consectetur adipisicing elit.
                      Inventore ducimus dolorem perspiciatis ipsam facere et
                      ullam
                    </p>
                  </div>
                  <div class="absolute top-2 left-4">
                    <Star fill="white" width="15" />
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div>
            <div class="mb-10 flex items-center gap-4">
              <Star fill="#7c80c4" />
              <h3 class="font-display text-4xl font-semibold text-acent sm:text-5xl">
                Hoteles
              </h3>
            </div>
            <div class="flex flex-col  gap-12">
              {hotelCategories.map((category) => {
                const hotels = subDestination.hotels.filter(
                  (hotel) => hotel.category === category,
                );

                return hotels.length > 0 ? (
                  <div>
                    <h4 class="mb-5  font-instrument uppercase text-subtitle-md font-semibold  text-primary">
                      {category}
                    </h4>
                    <div
                      class="hotel-embla overflow-hidden"
                      data-hotel-carousel={`${subDestination.id}-${category}`}
                    >
                      <div class="hotel-embla__container flex items-stretch">
                        {hotels.map((hotel) => (
                          <div class="hotel-embla__slide mr-5 flex min-h-125 min-w-0 shrink-0 flex-[0_0_78%] sm:flex-[0_0_48%] lg:flex-[0_0_32%]">
                            <article class="flex h-full w-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white">
                              <div class="group relative h-40 overflow-hidden">
                                <Image
                                  src={hotel.photo}
                                  alt={hotel.name}
                                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                />
                                <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 font-instrument text-xs font-semibold capitalize text-acent">
                                  {hotel.category}
                                </span>
                              </div>
                              <div class="flex flex-1 flex-col justify-between p-4 text-acent">
                                <h5 class="font-display text-xl font-semibold leading-tight hover:underline">
                                  {hotel.name}
                                </h5>
                                <dl class="mt-4  grid gap-5 font-instrument text-sm text-gray-600">
                                  <div class="flex items-start gap-4">
                                    <span class="flex shrink-0">
                                      <Star width="12" fill="#7c80c4" />
                                    </span>
                                    <div class="flex flex-col">
                                      <dt class="font-medium uppercase text-gray-700">
                                        Capacidad
                                      </dt>
                                      <dd class="capacity-text text-acent">
                                        {hotel.capacity}
                                      </dd>
                                    </div>
                                  </div>
                                  {hotel.transport && (
                                    <div class="flex items-start gap-4">
                                      <span class="flex shrink-0">
                                        <Star width="12" fill="#7c80c4" />
                                      </span>
                                      <div class="flex flex-col">
                                        <dt class="font-medium text-gray-700 uppercase ">
                                          Transporte
                                        </dt>
                                        <dd class="capacity-text text-acent">
                                          {hotel.transport}
                                        </dd>
                                      </div>
                                    </div>
                                  )}
                                  <div class="flex items-start gap-4">
                                    <span class="flex shrink-0">
                                      <Star width="12" fill="#EF90BB" />
                                    </span>
                                    <div class="flex flex-col">
                                      <dt class="font-medium uppercase text-gray-700">
                                        Early Park Admission
                                      </dt>
                                      <dd class="capacity-text text-acent">
                                        {hotel.earlyParkAdmission}
                                      </dd>
                                    </div>
                                  </div>
                                </dl>
                                <div class="mt-auto flex flex-wrap justify-center gap-2 pt-5">
                                  <button
                                    type="button"
                                    class="hotel-details-toggle rounded-full bg-gray-200 px-8 py-2 font-instrument text-sm font-semibold text-gray-600 transition-colors hover:cursor-pointer hover:bg-acent hover:text-white"
                                    aria-haspopup="dialog"
                                    aria-controls="hotel-details-modal"
                                    data-hotel-name={hotel.name}
                                    data-hotel-category={hotel.category}
                                    data-hotel-description={hotel.description}
                                    data-hotel-capacity={hotel.capacity}
                                    data-hotel-transport={hotel.transport ?? ""}
                                    data-hotel-early-admission={
                                      hotel.earlyParkAdmission
                                    }
                                  >
                                    Ver más
                                  </button>
                                  <button
                                    type="button"
                                    class="cotiza-button relative rounded-full bg-primary px-12 py-2 font-instrument text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:rotate-1 hover:bg-linear-to-r hover:from-[#7c80c4] hover:via-[#a5d6ef] hover:to-[#7c80c4] hover:shadow-[0_0_24px_rgba(124,128,196,0.55)]"
                                  >
                                    <span
                                      class="cotiza-star cotiza-star-one"
                                      aria-hidden="true"
                                    >
                                      ✦
                                    </span>
                                    <span
                                      class="cotiza-star cotiza-star-two"
                                      aria-hidden="true"
                                    >
                                      ✦
                                    </span>
                                    <span
                                      class="cotiza-star cotiza-star-three"
                                      aria-hidden="true"
                                    >
                                      ✦
                                    </span>
                                    Cotizá tu viaje
                                  </button>
                                </div>
                              </div>
                            </article>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ) : null;
              })}
            </div>
          </div>

          {ctaButtons && ctaButtons.length > 0 && (
            <div class="mt-16 p-8 md:p-12 rounded-3xl bg-primary/10 border border-primary/20 flex flex-col sm:flex-row items-center justify-between gap-6">
              <div>
                <h4 class="font-display text-2xl md:text-3xl font-bold text-acent">
                  ¿Querés cotizar tu viaje a {subDestination.label}?
                </h4>
                <p class="mt-2 font-instrument text-gray-600">
                  Te armamos un presupuesto personalizado sin costo adicional.
                </p>
              </div>
              <div class="flex flex-wrap gap-4">
                {ctaButtons.map((btn) => (
                  <a
                    href="/cotiza"
                    class="bg-primary hover:bg-[#6e72c3] transition-colors text-white font-instrument font-semibold px-6 py-3 rounded-full text-center shadow-md"
                  >
                    {btn.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      ))
    }
  </div>
  <div
    id="hotel-details-modal"
    class="hotel-modal fixed inset-0 z-50 hidden items-center justify-center p-4"
    aria-hidden="true"
  >
    <button
      type="button"
      class="hotel-modal-backdrop absolute inset-0 bg-black/45"
      data-hotel-modal-close
      aria-label="Cerrar modal"></button>
    <article
      role="dialog"
      aria-modal="true"
      aria-labelledby="hotel-modal-title"
      class="hotel-modal-panel relative z-10 max-h-[85vh] w-full max-w-2xl overflow-y-auto rounded-3xl border border-gray-200 bg-white p-6 md:p-8"
    >
      <button
        type="button"
        class="absolute right-4 cursor-pointer top-4 rounded-full border border-gray-300 px-3 py-1 font-instrument text-sm text-gray-600 transition-colors hover:bg-gray-100"
        data-hotel-modal-close
      >
        Cerrar
      </button>
      <span
        id="hotel-modal-category"
        class="inline-flex rounded-full bg-button px-3 py-1 font-instrument text-xs font-semibold capitalize text-acent"
      ></span>
      <h3
        id="hotel-modal-title"
        class="mt-4 font-display text-3xl font-semibold text-acent"
      >
      </h3>
      <p
        id="hotel-modal-description"
        class="mt-4 font-instrument text-base leading-relaxed text-gray-700"
      >
      </p>
      <dl class="mt-6 grid gap-5 font-instrument text-sm text-gray-700">
        <div class="flex items-start gap-4">
          <span class="flex shrink-0">
            <Star width="12" fill="#7c80c4" />
          </span>
          <div class="flex flex-col">
            <dt class="font-medium uppercase text-gray-700">Capacidad</dt>
            <dd id="hotel-modal-capacity" class="text-acent"></dd>
          </div>
        </div>
        <div id="hotel-modal-transport-row" class="flex items-start gap-4">
          <span class="flex shrink-0">
            <Star width="12" fill="#7c80c4" />
          </span>
          <div class="flex flex-col">
            <dt class="font-medium uppercase text-gray-700">Transporte</dt>
            <dd id="hotel-modal-transport" class="text-acent"></dd>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex shrink-0">
            <Star width="12" fill="#EF90BB" />
          </span>
          <div class="flex flex-col">
            <dt class="font-medium uppercase text-gray-700">
              Early Park Admission
            </dt>
            <dd id="hotel-modal-early-admission" class="text-acent"></dd>
          </div>
        </div>
      </dl>
      <button
        type="button"
        class="cotiza-button modal-quote-button relative mt-8 w-full rounded-full bg-primary px-12 py-3 font-instrument text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:rotate-1 hover:bg-linear-to-r hover:from-[#7c80c4] hover:via-[#a5d6ef] hover:to-[#7c80c4] hover:shadow-[0_0_24px_rgba(124,128,196,0.55)]"
      >
        <span class="cotiza-star cotiza-star-one" aria-hidden="true">✦</span>
        <span class="cotiza-star cotiza-star-two" aria-hidden="true">✦</span>
        <span class="cotiza-star cotiza-star-three" aria-hidden="true">✦</span>
        Cotizá tu viaje
      </button>
    </article>
  </div>
  <!-- <TopUp href="top" /> -->
</DisneyLayout>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  document.addEventListener("astro:page-load", () => {
    const hotelCarousels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-hotel-carousel]"),
    );
    const emblaInstances = hotelCarousels.map((carousel) =>
      EmblaCarousel(carousel, { loop: true, align: "start" }, [
        Autoplay({
          delay: 3000,
          stopOnMouseEnter: true,
          stopOnInteraction: false,
        }),
      ]),
    );

    const detailButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".hotel-details-toggle"),
    );
    const modal = document.getElementById("hotel-details-modal");
    const modalTitle = document.getElementById("hotel-modal-title");
    const modalCategory = document.getElementById("hotel-modal-category");
    const modalDescription = document.getElementById("hotel-modal-description");
    const modalCapacity = document.getElementById("hotel-modal-capacity");
    const modalTransport = document.getElementById("hotel-modal-transport");
    const modalEarlyAdmission = document.getElementById(
      "hotel-modal-early-admission",
    );
    const modalTransportRow = document.getElementById(
      "hotel-modal-transport-row",
    );
    const modalCloseButtons = Array.from(
      document.querySelectorAll<HTMLElement>("[data-hotel-modal-close]"),
    );

    const closeHotelModal = () => {
      if (!modal) {
        return;
      }

      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.classList.remove("hotel-modal-visible");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("hotel-modal-open");
    };

    detailButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (
          !modal ||
          !modalTitle ||
          !modalCategory ||
          !modalDescription ||
          !modalCapacity ||
          !modalTransport ||
          !modalEarlyAdmission ||
          !modalTransportRow
        ) {
          return;
        }

        const { hotelName, hotelCategory, hotelDescription, hotelCapacity } =
          button.dataset;
        const transport = button.dataset.hotelTransport?.trim() ?? "";
        const earlyAdmission = button.dataset.hotelEarlyAdmission ?? "";

        modalTitle.textContent = hotelName ?? "";
        modalCategory.textContent = hotelCategory ?? "";
        modalDescription.textContent = hotelDescription ?? "";
        modalCapacity.textContent = hotelCapacity ?? "";
        modalEarlyAdmission.textContent = earlyAdmission;

        modalTransportRow.classList.toggle("hidden", !transport);
        modalTransport.textContent = transport;

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.classList.add("hotel-modal-visible");
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("hotel-modal-open");
      });
    });

    modalCloseButtons.forEach((button) => {
      button.addEventListener("click", closeHotelModal);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeHotelModal();
      }
    });

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".subdestination-button"),
    );
    const destinationAnchor = document.getElementById("destination-anchor");
    const contents = Array.from(
      document.querySelectorAll<HTMLElement>(".subdestination-content"),
    );

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedId = button.dataset.subdestination;

        if (!selectedId) {
          return;
        }

        if (destinationAnchor) {
          destinationAnchor.href = `#subdestination-content-${selectedId}`;
        }

        buttons.forEach((currentButton) => {
          const isSelected = currentButton === button;
          currentButton.setAttribute("aria-pressed", String(isSelected));
          currentButton.classList.toggle("bg-white/80", isSelected);
          currentButton.classList.toggle("!text-black", isSelected);
          currentButton.classList.toggle("bg-white/15", !isSelected);
          currentButton.classList.toggle("hover:bg-white/80", !isSelected);
          currentButton.classList.toggle("hover:text-black", !isSelected);
        });

        contents.forEach((content) => {
          const isSelected =
            content.dataset.subdestinationContent === selectedId;
          content.classList.toggle("hidden", !isSelected);
          content.setAttribute("aria-hidden", String(!isSelected));
        });

        emblaInstances.forEach((embla) => embla.reInit());
      });
    });
  });
</script>

<style>
  .subdestination-button[aria-pressed="true"] {
    color: #000;
  }

  .capacity-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(body.hotel-modal-open) {
    overflow: hidden;
  }

  .hotel-modal-backdrop {
    opacity: 0;
  }

  .hotel-modal-panel {
    opacity: 0;
    transform: translateY(1rem) scale(0.96);
  }

  .hotel-modal-visible .hotel-modal-backdrop {
    animation: hotel-modal-backdrop-in 220ms ease-out forwards;
  }

  .hotel-modal-visible .hotel-modal-panel {
    animation: hotel-modal-panel-in 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hotel-modal-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hotel-modal-panel-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .cotiza-button {
    isolation: isolate;
  }

  .cotiza-star {
    position: absolute;
    z-index: 2;
    color: #ffffff;
    font-size: 1.15rem;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    text-shadow:
      0 0 4px #a5d6ef,
      0 0 10px #7c80c4;
    transform: scale(0.4);
  }

  .cotiza-star-one {
    top: -0.55rem;
    right: 1.1rem;
  }

  .cotiza-star-two {
    bottom: -0.4rem;
    left: 1.2rem;
    font-size: 0.9rem;
  }

  .cotiza-star-three {
    top: 0.1rem;
    left: -0.65rem;
    font-size: 0.8rem;
  }

  .cotiza-button:hover .cotiza-star {
    animation: disney-sparkle 850ms ease-out forwards;
  }

  .cotiza-button:hover .cotiza-star-two {
    animation-delay: 120ms;
  }

  .cotiza-button:hover .cotiza-star-three {
    animation-delay: 220ms;
  }

  @keyframes disney-sparkle {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    35% {
      opacity: 1;
      transform: scale(1.25) rotate(20deg);
    }
    100% {
      opacity: 0;
      transform: scale(0.8) rotate(45deg) translateY(-0.35rem);
    }
  }
</style>
