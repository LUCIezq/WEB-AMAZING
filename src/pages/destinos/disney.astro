    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .subdestination-button[aria-pressed="false"]:hover {
    background-color: rgba(255, 255, 255, 0.25) !important;
