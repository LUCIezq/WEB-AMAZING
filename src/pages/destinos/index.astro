---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { destinos } from "@data/Destinos";
import ArrowRight from "@components/icons/ArrowRight.astro";
import TopUp from "@components/common/TopUp.astro";

// Duplicate items so Embla has enough slides to loop and center perfectly
const carouselDestinos = [...destinos, ...destinos];
---

<BaseLayout title="Destinos - Disney Amazing">
  <div
    id="top"
    class="flex w-full flex-col items-center justify-center gap-4 pt-24 text-center sm:pt-32"
  >
    <div class="grid place-items-center gap-2 px-4 max-w-3xl">
      <span
        class="uppercase font-instrument font-semibold text-subtitle-sm text-primary tracking-widest"
      >
        Destinos
      </span>
      <h1 class="text-4xl font-display font-bold sm:text-title-lg text-acent">
        ¿Por dónde querés empezar?
      </h1>
      <p class="max-w-md font-instrument text-sm text-gray-600 sm:text-base">
        Elegí una categoría y te mostramos parques, hoteles, tickets y todo lo
        que necesitás saber antes de cotizar.
      </p>
    </div>

    <div class="relative w-full">
      <!-- Full-bleed carousel with generous vertical padding to prevent shadow clipping -->
      <div class="embla w-full overflow-hidden pt-4 pb-16 sm:pb-20">
        <div class="embla__container flex items-center">
          {
            carouselDestinos.map((a, idx) => (
              <div
                class="embla__slide min-w-0 flex-[0_0_65%] sm:flex-[0_0_38%] lg:flex-[0_0_24%] px-2 sm:px-3 py-4 select-none"
                data-dest-id={a.id}
                data-dest-index={idx % destinos.length}
              >
                <div class="destination-card group relative aspect-[3/4] overflow-hidden rounded-3xl cursor-pointer">
                  <Image
                    src={a.foto}
                    alt={`Destino ${a.nombre}`}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />

                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-transparent" />
                  <div class="destination-card-glow absolute inset-0 rounded-3xl" aria-hidden="true" />
                  <span class="destination-card-star destination-card-star-one" aria-hidden="true">✦</span>
                  <span class="destination-card-star destination-card-star-two" aria-hidden="true">✦</span>

                  <div class="absolute inset-0 z-10 flex flex-col justify-end p-4 text-start sm:p-5">
                    <h3 class="mb-1 font-display text-2xl font-bold text-white sm:text-3xl">
                      {a.nombre}
                    </h3>
                    <p class="text-xs leading-snug text-white/95 sm:text-sm font-instrument font-light line-clamp-3 sm:line-clamp-none" set:html={a.descripcion} />
                    <a
                      href={`/destinos/${a.id}`}
                      class="inline-flex items-center gap-2 rounded-full bg-white/20 hover:bg-white/35 backdrop-blur-md border border-white/50 px-3.5 py-1.5 text-xs font-semibold text-white tracking-wider transition-all duration-300 shadow-md mt-4 place-self-start"
                    >
                      EXPLORAR
                      <ArrowRight />
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="embla__dots flex justify-center items-center gap-2 -mt-8 mb-8 sm:-mt-10 sm:mb-10"></div>
    </div>
  </div>
  <TopUp href="top" />
</BaseLayout>

<style>
  .destination-card {
    isolation: isolate;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), opacity 500ms ease, box-shadow 500ms ease;
    transform: scale(0.9);
    opacity: 0.8;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .destination-card.is-active {
    transform: scale(1.05);
    opacity: 1;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    z-index: 10;
  }

  .destination-card-glow {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(165, 214, 239, 0.7),
      inset 0 0 28px rgba(165, 214, 239, 0.28),
      0 0 24px rgba(124, 128, 196, 0.35);
    transition: opacity 300ms ease;
  }

  .destination-card:hover .destination-card-glow {
    opacity: 1;
    animation: destination-card-glow 1.6s ease-in-out infinite;
  }

  .destination-card-star {
    position: absolute;
    z-index: 2;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    text-shadow:
      0 0 5px #a5d6ef,
      0 0 12px #7c80c4;
    transform: scale(0.4) rotate(0deg);
  }

  .destination-card-star-one {
    top: 1.5rem;
    right: 1.5rem;
    font-size: 1.4rem;
  }

  .destination-card-star-two {
    top: 3.5rem;
    right: 3.5rem;
    font-size: 0.8rem;
  }

  .destination-card:hover .destination-card-star {
    animation: destination-card-sparkle 800ms ease-out forwards;
  }

  .destination-card:hover .destination-card-star-two {
    animation-delay: 140ms;
  }

  @keyframes destination-card-glow {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.015);
    }
  }

  @keyframes destination-card-sparkle {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    35% {
      opacity: 1;
      transform: scale(1.25) rotate(20deg);
    }
    100% {
      opacity: 0;
      transform: scale(0.8) rotate(45deg) translateY(-0.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .destination-card {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    .destination-card-glow,
    .destination-card-star {
      animation: none !important;
    }
  }
</style>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  let emblaInstance: ReturnType<typeof EmblaCarousel> | null = null;

  const initializeDestinationsCarousel = () => {
    const viewport = document.querySelector(".embla") as HTMLElement | null;
    const dotsContainer = document.querySelector(".embla__dots") as HTMLElement | null;

    if (!viewport || !dotsContainer) {
      return;
    }

    if (emblaInstance) {
      emblaInstance.destroy();
      emblaInstance = null;
    }

    const autoplay = Autoplay({ delay: 3500, stopOnInteraction: false, stopOnMouseEnter: true });
    const embla = EmblaCarousel(viewport, {
      loop: true,
      align: "center",
      startIndex: 0,
      skipSnaps: false,
    }, [autoplay]);

    emblaInstance = embla;

    const slides = embla.slideNodes();
    const scrollSnaps = embla.scrollSnapList();

    const totalDestinos = 5;

    // Always generate exactly 5 dots for the 5 real destinations
    dotsContainer.innerHTML = Array.from({ length: totalDestinos })
      .map(
        (_, i) =>
          `<button class="embla__dot h-2 rounded-full cursor-pointer transition-all duration-300" data-index="${i}" aria-label="Ir al destino ${i + 1}"></button>`,
      )
      .join("");

    const dots = Array.from(dotsContainer.querySelectorAll(".embla__dot")) as HTMLElement[];

    const updateUI = () => {
      const selectedIndex = embla.selectedScrollSnap();
      const activeDestIndex = ((selectedIndex % totalDestinos) + totalDestinos) % totalDestinos;

      slides.forEach((slide, index) => {
        const card = slide.querySelector(".destination-card");
        if (!card) return;
        if (index === selectedIndex) {
          card.classList.add("is-active");
        } else {
          card.classList.remove("is-active");
        }
      });

      dots.forEach((dot, i) => {
        if (i === activeDestIndex) {
          dot.className = "embla__dot h-2 w-7 rounded-full bg-[#7c80c4] transition-all duration-300";
        } else {
          dot.className = "embla__dot h-2 w-2 rounded-full bg-[#a5d6ef] opacity-70 hover:opacity-100 transition-all duration-300";
        }
      });
    };

    dots.forEach((dot, targetIndex) => {
      dot.addEventListener("click", () => {
        const currentSnap = embla.selectedScrollSnap();
        const currentDestIndex = ((currentSnap % totalDestinos) + totalDestinos) % totalDestinos;
        let diff = targetIndex - currentDestIndex;
        // Shortest jump path in a modular 5-item loop
        if (diff > 2) diff -= totalDestinos;
        if (diff < -2) diff += totalDestinos;
        embla.scrollTo(currentSnap + diff);
      });
    });

    slides.forEach((slide, index) => {
      slide.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("a")) {
          embla.scrollTo(index);
        }
      });
    });

    embla.on("select", updateUI);
    embla.on("init", updateUI);
    embla.on("reInit", updateUI);

    updateUI();
  };

  document.addEventListener("astro:page-load", initializeDestinationsCarousel);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initializeDestinationsCarousel();
  }
</script>
