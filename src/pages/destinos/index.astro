---
import DisneyLayout from "../../layouts/DisneyLayout.astro";
import { Image } from "astro:assets";
import { destinos } from "../../data/Destinos";
import ArrowRight from "../../components/icons/Arrow-right.astro";
---

<DisneyLayout title="Destinos - Disney Amazing">
  <div
    class="flex w-full flex-col items-center justify-center gap-10 px-4 pt-32 text-center sm:px-6 sm:pt-40"
  >
    <div class="grid place-items-center">
      <span
        class="uppercase font-instrument font-medium text-subtitle-sm text-acent"
      >
        Destinos
      </span>
      <h1 class="text-4xl font-display font-bold sm:text-title-lg">
        ¿Por dónde querés empezar?
      </h1>
      <p class="max-w-md font-instrument text-sm text-gray-600 sm:text-base">
        Elegí una categoría y te mostramos parques, hoteles, tickets y todo lo
        que necesitás saber antes de cotizar.
      </p>
    </div>
    <div class="relative w-full pb-16">
      <div class="embla w-full overflow-hidden">
        <div class="embla__container flex gap-4 px-4">
          {
            destinos.map((a) => (
              <div class="embla__slide min-w-0 flex-[0_0_86%] sm:flex-[0_0_55%] lg:flex-[0_0_25%]">
                <div class="destination-card group relative aspect-2/3 overflow-hidden rounded-3xl shadow-xl">
                  <Image
                    src={a.foto}
                    alt={`Destino ${a.nombre}`}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                  />

                  <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent" />
                  <div class="destination-card-glow absolute inset-0 rounded-3xl" aria-hidden="true" />
                  <span class="destination-card-star destination-card-star-one" aria-hidden="true">✦</span>
                  <span class="destination-card-star destination-card-star-two" aria-hidden="true">✦</span>

                  <div class="absolute inset-0 z-10 flex flex-col justify-end p-4 text-start sm:p-6">
                    <h3 class="mb-2 font-display text-3xl font-bold text-white sm:text-4xl">
                      {a.nombre}
                    </h3>
                    <p class="text-sm leading-snug text-white sm:text-subtitle-lg">
                      {a.descripcion}
                    </p>
                    <a
                      href={`/destinos/${a.id}`}
                      class="inline-flex gap-1 items-center justify-center 
                      align-middle select-none font-sans font-medium text-center 
                      px-5 py-3 text-white text-sm  rounded-3xl bg-white/10 border border-white/50 
                    shadow-[inset_0_1px_0px_rgba(255,255,255,0.75),0_0_9px_rgba(0,0,0,0.2),0_3px_8px_rgba(0,0,0,0.15)]
                     hover:bg-white/30 transition-all duration-300 before:absolute place-self-start 
                     before:inset-0 before:rounded-3xl mt-7 before:bg-linear-to-br before:from-white/60 
                     before:via-transparent before:to-transparent before:opacity-70 before:pointer-events-none 
                     after:absolute after:inset-0 after:rounded-3xl after:bg-linear-to-br after:from-white/30 after:via-transparent after:to-transparent
                      after:opacity-50 after:pointer-events-none  antialiased"
                    >
                      EXPLORAR
                      <ArrowRight />
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="embla__dots flex justify-center gap-2 mt-6"></div>
    </div>
  </div>
</DisneyLayout>

<style>
  .destination-card {
    isolation: isolate;
    animation: destination-card-enter 700ms both;
  }

  .embla__slide:nth-child(2) .destination-card {
    animation-delay: 100ms;
  }

  .embla__slide:nth-child(3) .destination-card {
    animation-delay: 200ms;
  }

  .embla__slide:nth-child(4) .destination-card {
    animation-delay: 300ms;
  }

  .destination-card-glow {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(165, 214, 239, 0.7),
      inset 0 0 28px rgba(165, 214, 239, 0.28),
      0 0 24px rgba(124, 128, 196, 0.35);
    transition: opacity 300ms ease;
  }

  .destination-card:hover .destination-card-glow {
    opacity: 1;
    animation: destination-card-glow 1.6s ease-in-out infinite;
  }

  .destination-card-star {
    position: absolute;
    z-index: 2;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    text-shadow:
      0 0 5px #a5d6ef,
      0 0 12px #7c80c4;
    transform: scale(0.4) rotate(0deg);
  }

  .destination-card-star-one {
    top: 1.5rem;
    right: 1.5rem;
    font-size: 1.4rem;
  }

  .destination-card-star-two {
    top: 3.5rem;
    right: 3.5rem;
    font-size: 0.8rem;
  }

  .destination-card:hover .destination-card-star {
    animation: destination-card-sparkle 800ms ease-out forwards;
  }

  .destination-card:hover .destination-card-star-two {
    animation-delay: 140ms;
  }

  @keyframes destination-card-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes destination-card-glow {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.015);
    }
  }

  @keyframes destination-card-sparkle {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    35% {
      opacity: 1;
      transform: scale(1.25) rotate(20deg);
    }
    100% {
      opacity: 0;
      transform: scale(0.8) rotate(45deg) translateY(-0.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .destination-card {
      animation: none;
    }

    .destination-card-glow,
    .destination-card-star {
      animation: none;
    }
  }
</style>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const initializeDestinationsCarousel = () => {
    const viewport = document.querySelector(".embla") as HTMLElement | null;
    const dotsContainer = document.querySelector(
      ".embla__dots",
    ) as HTMLElement | null;

    if (!viewport || !dotsContainer) {
      return;
    }

    const embla = EmblaCarousel(viewport, { loop: true, align: "center" }, [
      Autoplay({ delay: 2500 }),
    ]);

    const scrollSnaps = embla.scrollSnapList();
    dotsContainer.innerHTML = scrollSnaps
      .map(
        (_, i) =>
          `<button class="embla__dot h-2 w-2 rounded-full bg-gray-300 transition-all duration-300" data-index="${i}" aria-label="Ir a la tarjeta ${i + 1}"></button>`,
      )
      .join("");

    const dots = Array.from(
      dotsContainer.querySelectorAll(".embla__dot"),
    ) as HTMLElement[];

    const updateDots = () => {
      const selected = embla.selectedScrollSnap();
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-primary", i === selected);
        dot.classList.toggle("w-6", i === selected);
        dot.classList.toggle("bg-gray-300", i !== selected);
      });
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => embla.scrollTo(i));
    });

    embla.on("select", updateDots);
    embla.on("init", updateDots);
    embla.plugins().autoplay?.play();
  };

  document.addEventListener(
    "astro:page-load",
    initializeDestinationsCarousel,
  );
</script>
