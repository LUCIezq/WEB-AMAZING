---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/home/Hero.astro";
import AboutUs from "@components/home/AboutUs.astro";
import Experience from "@components/home/Experience.astro";
import Parks from "@components/home/Parks.astro";
import TopUp from "@components/common/TopUp.astro";
---

<BaseLayout title="Inicio - Disney Amazing">
  <HeroSection />
  <div class="flex flex-col max-w-6xl w-full mx-auto gap-12 px-4 py-8">
    <AboutUs />
    <Experience />
    <Parks />
    <TopUp href="top" />
  </div>
</BaseLayout>
