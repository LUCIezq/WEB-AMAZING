---
import Facebook from "@components/icons/social/Facebook.astro";
import Instagram from "@components/icons/social/Instagram.astro";
import Whatsapp from "@components/icons/social/Whatsapp.astro";

interface Props {
  href: string;
  name: "Whatsapp" | "Facebook" | "Instagram";
}

const { href, name } = Astro.props;

const Icon = { Whatsapp, Instagram, Facebook }[name];
---

<a href={href} aria-label={name} class="w-5 h-5">
  <div class="w-3.5 h-3.5 text-white">
    <Icon />
  </div>
</a>
