---
import { Image } from "astro:assets";
import { homeData } from "../data/Home";
import image from "../assets/parks.jpg";

const { parks } = homeData;
---

<section
  class="flex min-h-80 w-full flex-col items-center gap-8 timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] md:flex-row md:gap-10"
>
  <Image alt="Estatua" src={image} width={350} class="w-full max-w-[350px]" />

  <div class="flex gap-4 flex-col w-full justify-center">
    <div>
      <span
        class="text-eyebrow font-instrument font-semibold uppercase text-acent"
      >
        {parks.eyebrow}
      </span>
      <div class="grid gap-2">
        <h6 class="font-display text-title-md font-semibold">
          {parks.title}
        </h6>
        <p class="font-instrument font-medium">
          El castillo de Disney y el castillo de Hogwarts en un mismo
          itinerario. <b>Combinamos parques, hoteles y tickets </b> para que vivas
          los dos universos sin perder tiempo ni presupuesto.
        </p>
      </div>
    </div>

    <a
      href={parks.linkUrl}
      class="place-self-center rounded-4xl bg-primary px-5 py-3 font-instrument font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:bg-linear-to-r hover:from-primary hover:via-button hover:to-primary hover:text-acent hover:shadow-[0_0_24px_rgba(124,128,196,0.55)] md:place-self-start"
      >{parks.linkText}</a
    >
  </div>
</section>
