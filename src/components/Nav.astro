---
import { navItems } from "../data/Nav";
import NavItem from "./NavItem.astro";

const ruta = Astro.url.pathname;
---

<nav
  class="absolute left-0 right-0 top-full flex hidden flex-col gap-6 bg-white p-5 shadow-md md:static md:flex md:flex-row md:items-center md:justify-center md:gap-15 md:bg-transparent md:p-0 md:shadow-none"
  id="main-nav"
>
  <ul class="flex flex-col gap-4 md:flex-row md:gap-15">
    {
      navItems.map((item) => (
        <NavItem
          isActive={
            item.href === "/" ? ruta === "/" : ruta.startsWith(item.href)
          }
          href={item.href}
          label={item.label}
        />
      ))
    }
  </ul>
  <a
    href="/cotiza"
    class="w-full rounded-3xl bg-primary px-4 py-2 text-center font-medium text-white transition-colors hover:bg-[#6e72c3] md:w-auto"
    >Cotizá tu viaje acá</a
  >
</nav>
