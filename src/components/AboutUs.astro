---
import { teamInfo } from "../data/Team";
import TeamCard from "./TeamCard.astro";
import { homeData } from "../data/Home";

const { aboutUs } = homeData;
---

<section
  id="nosotras"
  aria-labelledby="nosotras-title"
  class="flex w-full scroll-mt-32 flex-col items-center gap-8 timeline-view animate-zoom-in animate-range-[entry_0%_cover_20%]"
>
  <header class="grid gap-2 place-items-center text-center">
    <span
      class="font-instrument text-acent text-eyebrow font-semibold uppercase"
    >
      {aboutUs.eyebrow}
    </span>
    <div class="grid gap-2 place-items-center">
      <h4 class="font-display text-4xl font-semibold" id="nosotras-title">
        {aboutUs.title}
      </h4>
      <p class="font-instrument font-medium text-wrap">
        Tres viajeras, una misma obsesión: <b> que tu viaje salga perfecto.</b>
      </p>
    </div>
  </header>
  <div class="flex flex-wrap justify-center w-full gap-3">
    {
      teamInfo.map((e) => (
        <TeamCard
          id={e.id}
          nombre={e.nombre}
          descripcion={e.descripcion}
          imagen={e.imagen}
        />
      ))
    }
  </div>
</section>
