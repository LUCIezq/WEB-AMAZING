---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  imagen: ImageMetadata;
}

const { id, nombre, descripcion, imagen } = Astro.props;
---

<article
  class="group animate-slide-in-right
 relative overflow-hidden rounded-3xl aspect-3/4 w-80 h-80"
  aria-labelledby={id}
>
  <Image
    src={imagen}
    alt={nombre}
    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
  />

  <div
    class="absolute inset-0 bg-primary/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6"
  >
    <h3
      id={id}
      class="text-white uppercase font-instrument font-semibold mb-1 text-card-title"
    >
      {nombre}
    </h3>
    <p class="text-white/90 text-card-description">{descripcion}</p>
  </div>
</article>
