---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  imagen: ImageMetadata;
}

const { id, nombre, descripcion, imagen } = Astro.props;
---

<article
  class="group relative h-80 w-full max-w-80 animate-slide-in-right overflow-hidden rounded-3xl"
  aria-labelledby={id}
>
  <Image
    src={imagen}
    alt={nombre}
    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 group-hover:rotate-1"
  />

  <div
    class="absolute inset-0 flex translate-y-4 flex-col justify-end bg-linear-to-t from-acent/95 via-primary/85 to-primary/55 p-6 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100"
  >
    <span
      class="pointer-events-none absolute right-6 top-6 text-2xl text-white opacity-0 drop-shadow-[0_0_8px_#a5d6ef] transition-all duration-500 group-hover:rotate-12 group-hover:opacity-100"
      aria-hidden="true">✦</span
    >
    <span
      class="pointer-events-none absolute right-12 top-12 text-sm text-button opacity-0 drop-shadow-[0_0_6px_#7c80c4] transition-all delay-100 duration-500 group-hover:-translate-y-1 group-hover:opacity-100"
      aria-hidden="true">✦</span
    >
    <h3
      id={id}
      class="mb-1 translate-y-3 text-card-title font-instrument font-semibold uppercase text-white opacity-0 transition-all delay-75 duration-500 group-hover:translate-y-0 group-hover:opacity-100"
    >
      {nombre}
    </h3>
    <p class="translate-y-3 text-card-description text-white/90 opacity-0 transition-all delay-150 duration-500 group-hover:translate-y-0 group-hover:opacity-100">
      {descripcion}
    </p>
  </div>
</article>
