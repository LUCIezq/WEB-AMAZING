---
import ArrowUp from "./icons/ArrowUp.astro";
import WhatsappColour from "./icons/social-icons/WhatsappColour.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<div class="fixed bottom-4 right-4 sm:bottom-10 sm:right-10 z-30 grid place-items-center gap-3">
  <a
    href={`#${href}`}
    aria-label="Volver arriba"
    class="bg-acent grid place-content-center hover:bg-acent/90 rounded-full w-10 h-10 shadow-lg transition-transform hover:scale-105"
  >
    <ArrowUp />
  </a>
  <a
    href="https://wa.me/5491112345678"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp a Amazing Travel"
    class="hover:scale-105 transition-transform drop-shadow-lg"
  >
    <WhatsappColour />
  </a>
</div>
