---
import ArrowUp from "./icons/ArrowUp.astro";
import WhatsappColour from "./icons/social-icons/WhatsappColour.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<div class="fixed bottom-4 right-4 z-30 grid place-items-center gap-3 sm:bottom-10 sm:right-10">
  <a
    href=`#${href}`
    class="bg-acent grid place-content-center hover:bg-acent/90 rounded-full w-9 h-9"
  >
    <ArrowUp />
  </a>
  <a href="#">
    <WhatsappColour />
  </a>
</div>
